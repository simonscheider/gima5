@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix dc: <http://purl.org/dc/elements/1.1/>.
@prefix dbp: <http://dbpedia.org/resource/>.
@prefix dbp-ont: <http://dbpedia.org/ontology/>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.

dbp:Jenning_de_Boo rdf:type dbp-ont:Athlete;
	foaf:name "Jenning de Boo" ;
	dbp-ont:birthDate "2004-01-22"^^xsd:date ;
	dbp-ont:thumbnail <https://schaatsteamreggeborgh.nl/wp-content/uploads/2022/08/Jenning-bewerkt.jpg> ;
	dbp-ont:birthPlace dbp:Groningen ;
	dbp-ont:sport dbp:Speedskating .

#Locations of important sporting events
dbp:Groningen
	wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(6.566667 53.216667)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
	rdfs:label "Groningen, Netherlands" .

dbp:Inzell 
	wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(12.750000 47.766667)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
	rdfs:label "Inzell, Germany" .

dbp:Milan 
	wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(9.183333 45.466667)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
	rdfs:label "Milan, Italy" .

dbp:Heerenveen 
	wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(5.916667 52.950000)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
	rdfs:label "Heerenveen, Netherlands" .

dbp:Calgary 
	wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-114.066667 51.050000)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
	rdfs:label "Calgary, Canada" .

dbp:Salt_Lake_City 
	wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-111.891111 40.760833)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
	rdfs:label "Salt Lake City, USA" .

#Important events
dbp:pr500
	dbp-ont:location dbp:Salt_Lake_City ;
	dbp-ont:date "2025-11-16"^^xsd:date .

dbp:pr1000
	dbp-ont:location dbp:Calgary ; 
	dbp-ont:date "2025-01-25"^^xsd:date .
	
dbp:pr1500
	dbp-ont:location dbp:Heerenveen ;
	dbp-ont:date "2025-10-04"^^xsd:date .
	
dbp:olympicDebut
	dbp-ont:location dbp:Milan ;
	dbp-ont:date "2026-02-01"^^xsd:date.

dbp:firstMedal
	dbp-ont:location dbp:Inzell ;
	dbp-ont:date "2023-02-12"^^xsd:date .