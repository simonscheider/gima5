# Spatial Career Biography of Carlos Alcaraz

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dbp: <http://dbpedia.org/resource/>.
@prefix dbp-ont: <http://dbpedia.org/ontology/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#>.

# Basic information about Carlos Alcaraz
dbp:Carlos_Alcaraz rdf:type dbp-ont:Athlete ;
    foaf:name "Carlos Alcaraz" ;
    dbp-ont:birthDate "2003-05-05"^^xsd:date ;
    dbp-ont:birthPlace dbp:El_Palmar ;
    dbp-ont:thumbnail <https://static01.nyt.com/images/2022/05/22/multimedia/20french-alcaraz1-print/20french-alcaraz-top-mediumSquareAt3X.jpg> ;
    dbp-ont:nationality dbp:Spain ;
    dbp-ont:sport dbp:Tennis ;
    dbp-ont:coach dbp:Juan_Carlos_Ferrero ; 
    dbp-ont:training dbp:Juan_Carlos_Ferrero_Academy ; 
    dbp-ont:trainingPlace dbp:Villena ;
    rdfs:label "Carlos Alcaraz" .

# Coach
dbp:Juan_Carlos_Ferrero
    rdf:type dbp-ont:Person ;
    foaf:name "Juan Carlos Ferrero" .

# Important locations for Carlos Alcaraz
dbp:El_Palmar 
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-1.1700 37.9800)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
    rdfs:label "El Palmar, Murcia" .

dbp:Rio_de_Janeiro 
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-43.1729 -22.9068)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
    rdfs:label "Rio de Janeiro" .

dbp:Melbourne 
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(144.9631 -37.8136)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
    rdfs:label "Melbourne" .

dbp:New_York_City 
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-74.0060 40.7128)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
    rdfs:label "New York City" .

dbp:London 
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-0.1276 51.5072)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
    rdfs:label "London" .

dbp:Paris 
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(2.3522 48.8566)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
    rdfs:label "Paris" .

dbp:Villena 
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-0.8650 38.6370)"^^<http://www.opengis.net/ont/sf#wktLiteral> ;
    rdfs:label "Villena" .

# More information for each milestone in his career
dbp:Rio_Open_2020
    rdf:type dbp-ont:SportsEvent ;
    rdfs:label "ATP Debut - Rio Open" ;
    dbp-ont:location dbp:Rio_de_Janeiro ;
    dbp-ont:date "2020-02-18"^^xsd:date ;
    dbp-ont:participant dbp:Carlos_Alcaraz .

dbp:Australian_Open_2026
    rdf:type dbp-ont:SportsEvent ;
    rdfs:label "Career Grand Slam Completion" ;
    dbp-ont:location dbp:Melbourne ;
    dbp-ont:date "2026-01-25"^^xsd:date ;
    dbp-ont:winner dbp:Carlos_Alcaraz .

dbp:US_Open_2022
    rdf:type dbp-ont:SportsEvent ;
    rdfs:label "First Grand Slam Title & World No.1" ;
    dbp-ont:location dbp:New_York_City ;
    dbp-ont:date "2022-09-11"^^xsd:date ;
    dbp-ont:winner dbp:Carlos_Alcaraz .

dbp:Wimbledon_2023
    rdf:type dbp-ont:SportsEvent ;
    rdfs:label "Wimbledon Champion" ;
    dbp-ont:location dbp:London ;
    dbp-ont:date "2023-07-16"^^xsd:date ;
    dbp-ont:winner dbp:Carlos_Alcaraz .

dbp:Olympics_Paris_2024
    rdf:type dbp-ont:SportsEvent ;
    rdfs:label "Olympic Silver Medal" ;
    dbp-ont:location dbp:Paris ;
    dbp-ont:date "2024-08-04"^^xsd:date ;
    dbp-ont:participant dbp:Carlos_Alcaraz .

dbp:Juan_Carlos_Ferrero_Academy
    rdf:type dbp-ont:Organisation ;
    rdfs:label "Juan Carlos Ferrero Academy" ;
    dbp-ont:location dbp:Villena .