# Spatial Biography of Pyotr Ilyich Tchaikovsky (1840-1893)

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#>.
@prefix xml:     <http://www.w3.org/XML/1998/namespace>.
@prefix dc:      <http://purl.org/dc/elements/1.1/>.
@prefix dbp:     <http://dbpedia.org/resource/>.
@prefix dbp-ont: <http://dbpedia.org/ontology/>.
@prefix dct:     <http://purl.org/dc/terms/>.
@prefix wgs84:   <http://www.w3.org/2003/01/geo/wgs84_pos#>.
@prefix foaf:    <http://xmlns.com/foaf/0.1/>.

# Pyotr Ilyich Tchaikovsky

dbp:Pyotr_Ilyich_Tchaikovsky
    foaf:name          "Pyotr Ilyich Tchaikovsky" ;
    dbp-ont:birthPlace dbp:Votkinsk ;
    dbp-ont:birthDate  "1840-05-07"^^xsd:date ;
    dbp-ont:deathPlace dbp:Saint_Petersburg ;
    dbp-ont:deathDate  "1893-11-06"^^xsd:date ;
    dbp-ont:thumbnail  <https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/Tchaikovsky_by_Reutlinger_%28cropped%29.jpg/330px-Tchaikovsky_by_Reutlinger_%28cropped%29.jpg> ;
    dbp-ont:spouse     dbp:Antonina_Miliukova ;
    dbp-ont:sponsor    dbp:Nadezhda_von_Meck .

# Q1 & Q2 - Birth and death locations

dbp:Votkinsk
    rdfs:label     "Votkinsk, Russia" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(53.9956 57.0531)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:Saint_Petersburg
    rdfs:label     "Saint Petersburg, Russia" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(30.3158 59.9343)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

# Q3 & Q6 - The three ballets

dbp:Swan_Lake
    rdf:type                dbp-ont:Ballet ;
    dbp-ont:composer        dbp:Pyotr_Ilyich_Tchaikovsky ;
    rdfs:label              "Swan Lake (1877)" ;
    dbp-ont:premiereVenue   dbp:Bolshoi_Theatre ;
    wgs84:geometry          "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(37.6155 55.7601)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:The_Nutcracker
    rdf:type                dbp-ont:Ballet ;
    dbp-ont:composer        dbp:Pyotr_Ilyich_Tchaikovsky ;
    rdfs:label              "The Nutcracker (1892)" ;
    dbp-ont:premiereVenue   dbp:Mariinsky_Theatre ;
    wgs84:geometry          "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(30.2963 59.9259)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:The_Sleeping_Beauty
    rdf:type                dbp-ont:Ballet ;
    dbp-ont:composer        dbp:Pyotr_Ilyich_Tchaikovsky ;
    rdfs:label              "The Sleeping Beauty (1890)" ;
    dbp-ont:premiereVenue   dbp:Mariinsky_Theatre ;
    wgs84:geometry          "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(30.2963 59.9259)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:Bolshoi_Theatre
    rdfs:label "Bolshoi Theatre, Moscow" .

dbp:Mariinsky_Theatre
    rdfs:label "Mariinsky Theatre, Saint Petersburg" .

# Q4 - First major tour (1888)
# Cities: Leipzig, Hamburg, Berlin, Prague, Paris, London

dbp:European_Tour_1888
    dbp-ont:conductor dbp:Pyotr_Ilyich_Tchaikovsky ;
    rdfs:label        "First European Conducting Tour (1888)" ;
    dc:coverage       dbp:Leipzig ,
                      dbp:Hamburg ,
                      dbp:Berlin ,
                      dbp:Prague ,
                      dbp:Paris ,
                      dbp:London .

dbp:Leipzig
    rdfs:label     "Leipzig, Germany" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(12.3731 51.3397)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:Hamburg
    rdfs:label     "Hamburg, Germany" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(9.9937 53.5507)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:Berlin
    rdfs:label     "Berlin, Germany" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(13.4050 52.5200)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:Prague
    rdfs:label     "Prague, Czech Republic" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(14.4378 50.0755)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:Paris
    rdfs:label     "Paris, France" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(2.3522 48.8566)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

dbp:London
    rdfs:label     "London, United Kingdom" ;
    wgs84:geometry "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-0.1276 51.5074)"^^<http://www.opengis.net/ont/sf#wktLiteral> .

# Q5 - Patron

dbp:Nadezhda_von_Meck
    foaf:name  "Nadezhda von Meck" ;
    rdfs:label "Nadezhda von Meck" .

# BONUS Q7 - Cannons!
# 16 shots total written in the score

<http://dbpedia.org/resource/1812_Overture>
    dbp-ont:composer    dbp:Pyotr_Ilyich_Tchaikovsky ;
    rdfs:label          "1812 Overture, Op. 49 (1882)" ;
    dbp-ont:cannonShots "16"^^xsd:integer .

# Other data

dbp:Antonina_Miliukova
    foaf:name  "Antonina Miliukova" ;
    rdfs:label "Antonina Miliukova" .
